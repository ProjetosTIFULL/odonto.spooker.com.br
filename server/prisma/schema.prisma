// Multi-tenant: todo dado pertence a uma Clinica (clínica ou dentista autônomo).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoConta {
  CLINICA
  AUTONOMO
}

/// Perfil de acesso do usuário
/// ADMIN: tudo · OPERADOR (secretário/operador): tudo menos Configurações · DENTISTA (dentista/médico): só Agenda
enum Papel {
  ADMIN
  DENTISTA
  OPERADOR
}

/// Função do colaborador na clínica (só DENTISTA aparece como coluna na agenda)
enum FuncaoColaborador {
  DENTISTA
  SECRETARIO
}

enum StatusPaciente {
  ATIVO
  EM_TRATAMENTO
  INATIVO
}

enum StatusConsulta {
  AGENDADA
  CONFIRMADA
  EM_ATENDIMENTO
  CONCLUIDA
  FALTOU
  CANCELADA
  /// Não aconteceu porque foi remarcada: a nova consulta é outro registro
  REMARCADA
}

enum Remetente {
  PACIENTE
  CLINICA
}

/// So se aplica a mensagens da CLINICA - o que a Evolution API (WhatsApp)
/// reporta via evento messages.update (equivalente aos "tiquinhos" azuis).
enum StatusMensagem {
  ENVIADA
  ENTREGUE
  LIDA
  FALHOU
}

model Clinica {
  id        String    @id @default(uuid())
  tipo      TipoConta @default(CLINICA)
  nome      String
  documento String? // CNPJ ou CPF
  cro       String?
  telefone  String?
  email     String?
  endereco  String?
  /// Id do agente correspondente no Orquestrador (spooker-platform) - liga essa clínica
  /// ao agente de WhatsApp/IA dela. Null = clínica ainda não tem agente de IA conectado.
  agentId   Int?      @unique
  criadoEm  DateTime  @default(now())

  /// Lembretes automáticos - cada um com seu próprio liga/desliga e mensagem
  /// (editável pelo ADMIN da clínica). TODOS desligados por padrão de
  /// propósito: só liga sabendo que isso manda mensagem pro paciente sem
  /// precisar de ninguém clicar. {nome} no texto vira o primeiro nome do
  /// paciente na hora de enviar.
  lembreteConfirmacao24hAtivo    Boolean @default(false)
  lembreteConfirmacao24hMensagem String  @default("Olá {nome}! Lembrando da sua consulta amanhã às {hora}. Pode confirmar? Responda por aqui.")

  lembreteDiaConsultaAtivo    Boolean @default(false)
  lembreteDiaConsultaMensagem String  @default("Olá {nome}! Sua consulta é hoje às {hora}. Te esperamos!")

  lembreteAniversarioAtivo    Boolean @default(false)
  lembreteAniversarioMensagem String  @default("Parabéns, {nome}! 🎉 A equipe deseja a você um dia maravilhoso e um ano repleto de saúde e sorrisos!")

  lembreteRetornoAtivo        Boolean @default(false)
  lembreteRetornoMensagem     String  @default("Olá {nome}! Faz um tempo que você não vem aqui. Que tal agendar uma consulta de retorno?")
  /// Meses sem visita pra entrar na campanha de retorno.
  lembreteRetornoMesesLimite  Int     @default(6)

  lembretePesquisaSatisfacaoAtivo    Boolean @default(false)
  lembretePesquisaSatisfacaoMensagem String  @default("Olá {nome}! Como foi sua consulta de hoje? Adoraríamos saber sua opinião, de 1 a 5. 😊")

  usuarios      Usuario[]
  profissionais Profissional[]
  pacientes     Paciente[]
  procedimentos Procedimento[]
  consultas     Consulta[]
  horarios      HorarioAtendimento[]
  conversas     Conversa[]
  avaliacoes    Avaliacao[]
}

model Usuario {
  id        String   @id @default(uuid())
  clinicaId String
  nome      String
  email     String   @unique
  senhaHash String
  papel     Papel    @default(OPERADOR)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  clinica      Clinica       @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  profissional Profissional?

  @@index([clinicaId])
}

/// Colaborador da clínica: dentistas e secretários/operadores
model Profissional {
  id            String            @id @default(uuid())
  clinicaId     String
  usuarioId     String?           @unique
  nome          String
  funcao        FuncaoColaborador @default(DENTISTA)
  especialidade String?
  cro           String?
  telefone      String?
  email         String?
  cor           String            @default("#0e7c86")
  ativo         Boolean           @default(true)

  /// Agenda Google conectada (opcional, por profissional) - so preenchido
  /// depois que ele mesmo autoriza via OAuth. refreshToken fica
  /// criptografado (nunca em texto puro no banco).
  googleEmail                      String?
  googleRefreshTokenCriptografado  String?
  googleConectadoEm                DateTime?

  clinica   Clinica    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  consultas Consulta[]

  @@index([clinicaId])
}

model Paciente {
  id          String         @id @default(uuid())
  clinicaId   String
  nome        String
  telefone    String // somente dígitos, com DDI: 5551999999999
  email       String?
  cpf         String?
  nascimento  DateTime?      @db.Date
  convenio    String?
  observacoes String?
  status      StatusPaciente @default(ATIVO)
  criadoEm    DateTime       @default(now())
  atualizadoEm DateTime      @updatedAt
  /// Dedupe dos lembretes automáticos que não são ligados a uma consulta específica.
  ultimoParabensEm           DateTime?
  ultimaCampanhaRetornoEm    DateTime?

  clinica   Clinica    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  consultas Consulta[]
  conversas Conversa[]

  @@unique([clinicaId, telefone])
  @@index([clinicaId, nome])
}

model Procedimento {
  id         String  @id @default(uuid())
  clinicaId  String
  nome       String
  codigoTuss String?
  duracaoMin Int     @default(30)
  valor      Decimal @db.Decimal(10, 2)
  ativo      Boolean @default(true)

  clinica   Clinica    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  consultas Consulta[]

  @@index([clinicaId])
}

model Consulta {
  id             String         @id @default(uuid())
  clinicaId      String
  pacienteId     String
  profissionalId String
  procedimentoId String?
  inicio         DateTime
  fim            DateTime
  status         StatusConsulta @default(AGENDADA)
  valor          Decimal?       @db.Decimal(10, 2)
  observacoes    String?
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt
  /// Dedupe dos lembretes automáticos ligados a essa consulta (evita mandar 2x se o job rodar de novo no mesmo dia).
  confirmacaoEnviada        Boolean @default(false)
  lembreteDiaEnviado        Boolean @default(false)
  pesquisaSatisfacaoEnviada Boolean @default(false)
  /// Id do evento criado na Google Agenda do profissional (se ele tiver conectado) - usado pra atualizar/excluir o evento depois.
  googleEventId             String?

  clinica      Clinica       @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  paciente     Paciente      @relation(fields: [pacienteId], references: [id], onDelete: Cascade)
  profissional Profissional  @relation(fields: [profissionalId], references: [id])
  procedimento Procedimento? @relation(fields: [procedimentoId], references: [id], onDelete: SetNull)
  avaliacao    Avaliacao?

  @@index([clinicaId, inicio])
  @@index([profissionalId, inicio])
}

model HorarioAtendimento {
  id        String  @id @default(uuid())
  clinicaId String
  diaSemana Int // 0 = domingo ... 6 = sábado
  abre      String // "08:00"
  fecha     String // "19:00"
  ativo     Boolean @default(true)

  clinica Clinica @relation(fields: [clinicaId], references: [id], onDelete: Cascade)

  @@unique([clinicaId, diaSemana])
}

model Conversa {
  id              String    @id @default(uuid())
  clinicaId       String
  pacienteId      String?
  telefone        String
  nomeContato     String?
  fotoUrl         String?
  naoLidas        Int       @default(0)
  ultimaMensagemEm DateTime @default(now())

  clinica   Clinica    @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  paciente  Paciente?  @relation(fields: [pacienteId], references: [id], onDelete: SetNull)
  mensagens Mensagem[]

  @@unique([clinicaId, telefone])
  @@index([clinicaId, ultimaMensagemEm])
}

model Mensagem {
  id            String        @id @default(uuid())
  conversaId    String
  de            Remetente
  texto         String?
  midiaUrl      String?
  midiaTipo     String?
  whatsappId    String?
  status        StatusMensagem @default(ENVIADA)
  enviadaEm     DateTime      @default(now())

  conversa Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId, enviadaEm])
  @@index([whatsappId])
}

/// Nota pós-consulta (1 a 5) dada pelo paciente. Uma por consulta concluída.
model Avaliacao {
  id         String   @id @default(uuid())
  clinicaId  String
  consultaId String   @unique
  nota       Int
  comentario String?
  criadoEm   DateTime @default(now())

  clinica  Clinica  @relation(fields: [clinicaId], references: [id], onDelete: Cascade)
  consulta Consulta @relation(fields: [consultaId], references: [id], onDelete: Cascade)

  @@index([clinicaId, criadoEm])
}
